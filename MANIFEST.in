include README.md LICENSE CITATION.cff
include requirements.txt requirements-dev.txt requirements-tested.txt MANIFEST.sha256 .gitignore VALIDATION.json
recursive-include configs *.json
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include tools *.py
recursive-include src/pni_cga *.py *.json *.txt
global-exclude *.pyc *.pyo
prune outputs
prune build
prune dist
prune .git
